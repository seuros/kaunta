#!/usr/bin/env ruby
# frozen_string_literal: true

binary = File.expand_path("../libexec/kaunta", __dir__)

unless File.file?(binary)
  # Platform gems are published without the OS version (arm64-darwin, not
  # arm64-darwin-23), so name the one that actually exists.
  local = Gem::Platform.local
  platform = [local.cpu, local.os].compact.join("-")

  warn <<~MESSAGE
    This is the kaunta stub gem: no native binary is bundled for #{platform}.

    Install a platform release:   gem install kaunta --platform #{platform}
    Or build from source:         cargo install --git https://github.com/seuros/kaunta kaunta
  MESSAGE
  exit 1
end

exec binary, *ARGV
